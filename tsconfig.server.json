{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "allowJs": true
  },
  // update-feed.mjs is typechecked here only. Do not add it to
  // tsconfig.server.build.json — that widens tsc rootDir to the repo root
  // and emits dist-server/server/index.js instead of dist-server/index.js.
  "include": ["server", "electron/update-feed.mjs"]
}
