{
  "name": "velarixbot",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.ts",
    "dev:desktop": "electron .",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vite build && playwright test e2e/fake-engine-smoke.spec.ts --workers=1 --reporter=line",
    "test:e2e": "vite build && playwright test --config=playwright.release.config.ts",
    "typecheck:smoke": "tsc -p tsconfig.e2e.json",
    "verify:inventories": "vitest run server/import-hygiene.test.ts server/saas-route-surface.test.ts server/secret-scan.test.ts",
    "verify:lint-format": "node scripts/verify-lint-format.mjs",
    "verify:release-gate": "node scripts/verify-release-gate.mjs",
    "eval": "node eval/run.mjs",
    "preview": "vite preview",
    "build:server": "node scripts/build-server.mjs",
    "build:speech": "node scripts/build-speech-helper.mjs",
    "fetch:cua": "node scripts/fetch-cua-driver.mjs",
    "stage:cua-sdk": "node scripts/stage-cua-sdk.mjs",
    "stage:sqlite": "node scripts/stage-sqlite.mjs",
    "package:mac": "pnpm build && pnpm build:server && pnpm stage:sqlite && pnpm build:speech && pnpm fetch:cua && pnpm stage:cua-sdk && electron-builder --mac --arm64 --publish never",
    "package:win": "pnpm build && pnpm build:server && pnpm stage:sqlite && pnpm fetch:cua && pnpm stage:cua-sdk && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@trycua/cua-driver": "^0.19.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "4.10.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.10",
    "yaml": "2.8.1"
  }
}
